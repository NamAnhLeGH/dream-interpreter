{
  "name": "dream-interpreter-api",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered dream interpretation API",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "dev:clean": "lsof -ti:3000 | xargs kill -9 2>/dev/null; tsx watch server.ts",
    "test:db": "tsx scripts/testConnection.ts",
    "test:queries": "tsx scripts/testQueries.ts",
    "test:api": "tsx scripts/testAPI.ts",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "dream",
    "interpretation",
    "AI",
    "API"
  ],
  "author": "Your Team",
  "license": "MIT",
  "engines": {
    "node": "20.x",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@xenova/transformers": "^2.6.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "node-llama-cpp": "^3.14.2",
    "pg": "^8.11.3",
    "prisma": "^7.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.2",
    "@types/pg": "^8.15.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
